# Server Configuration
NODE_ENV=production
PORT=8101
SERVICE_NAME=academics-service
SERVICE_VERSION=1.0.0

# Database Configuration
DB_HOST=postgres-primary.yourdomain.com
DB_PORT=5432
DB_NAME=academics_db
DB_USER=academics_user
DB_PASSWORD=your-secure-db-password
DB_SSL=true

# Redis Configuration
REDIS_HOST=redis.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq.yourdomain.com
RABBITMQ_PORT=5672
RABBITMQ_USER=academics-service
RABBITMQ_PASSWORD=your-secure-rabbitmq-password
RABBITMQ_VHOST=/

# Service URLs
AUTH_SERVICE_URL=https://auth.yourdomain.com
IDENTITY_PROVIDER_URL=https://identity.yourdomain.com
OBSERVABILITY_SERVICE_URL=https://observability.yourdomain.com
EVENT_BUS_URL=https://event-bus.yourdomain.com
SCHEMA_REGISTRY_URL=https://schema-registry.yourdomain.com
SECRETS_MANAGER_URL=https://secrets-manager.yourdomain.com
FEATURE_FLAGS_URL=https://feature-flags.yourdomain.com
BACKUP_SERVICE_URL=https://backup-service.yourdomain.com

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-key
JWT_ISSUER=identity-provider
JWT_AUDIENCE=academics-service

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8101
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_NEW_CURRICULUM=true
FEATURE_AUTO_SCHEDULING=false
FEATURE_CREDIT_TRANSFER=true

# External Services
BACKUP_ENABLED=true
BACKUP_CRON_SCHEDULE=0 2 * * *
