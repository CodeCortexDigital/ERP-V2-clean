# Server Configuration
NODE_ENV=development
PORT=8101
SERVICE_NAME=academics-service
SERVICE_VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academics_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Service URLs
AUTH_SERVICE_URL=http://localhost:8001
IDENTITY_PROVIDER_URL=http://localhost:8002
OBSERVABILITY_SERVICE_URL=http://localhost:8009
EVENT_BUS_URL=http://localhost:8060
SCHEMA_REGISTRY_URL=http://localhost:8040
SECRETS_MANAGER_URL=http://localhost:8007
FEATURE_FLAGS_URL=http://localhost:8028
BACKUP_SERVICE_URL=http://localhost:8062

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ISSUER=identity-provider
JWT_AUDIENCE=academics-service

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8101
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
FEATURE_NEW_CURRICULUM=true
FEATURE_AUTO_SCHEDULING=false
FEATURE_CREDIT_TRANSFER=true

# External Services
BACKUP_ENABLED=true
BACKUP_CRON_SCHEDULE=0 2 * * *
