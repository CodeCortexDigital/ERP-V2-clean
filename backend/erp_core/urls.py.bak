"""
Main URL Configuration
"""

from django.contrib import admin
from django.urls import path, include
from django.http import JsonResponse
from datetime import datetime
from rest_framework_simplejwt.views import TokenObtainPairView, TokenRefreshView, TokenVerifyView

def health_check(request):
    return JsonResponse({
        "status": "healthy",
        "apps": 73,
        "timestamp": str(datetime.now())
    })

urlpatterns = [
    path('admin/', admin.site.urls),
    path('health/', health_check, name='health-check'),
    path('api/', include('apps.api.urls')),
    path('api/master/', include('apps.api_master.urls')),
    
    # Authentication endpoints
    path('api/token/', TokenObtainPairView.as_view(), name='token_obtain_pair'),
    path('api/token/refresh/', TokenRefreshView.as_view(), name='token_refresh'),
    path('api/token/verify/', TokenVerifyView.as_view(), name='token_verify'),
]

# Simple schema view
from django.http import JsonResponse

def schema_view(request):
    schema = {
        "openapi": "3.0.0",
        "info": {
            "title": "ERP System API",
            "description": "ERP System with 73 apps",
            "version": "1.0.0"
        },
        "paths": {
            "/api/": {
                "get": {
                    "summary": "API Info",
                    "responses": {"200": {"description": "OK"}}
                }
            },
            "/api/health/": {
                "get": {
                    "summary": "Health Check",
                    "responses": {"200": {"description": "OK"}}
                }
            },
            "/api/token/": {
                "post": {
                    "summary": "Login",
                    "description": "Get JWT token",
                    "requestBody": {
                        "required": True,
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "username": {"type": "string"},
                                        "password": {"type": "string"}
                                    }
                                }
                            }
                        }
                    },
                    "responses": {"200": {"description": "OK"}}
                }
            }
        }
    }
    return JsonResponse(schema)

# Simple HTML views for documentation
from django.shortcuts import render
from apps.api.views_user import UserDetailView
from apps.api_master import urls as master_urls

def swagger_ui(request):
    return render(request, 'swagger.html', {'schema_url': '/schema/'})

def redoc_ui(request):
    return render(request, 'redoc.html', {'schema_url': '/schema/'})

urlpatterns += [
    path('api/accounts/me/', UserDetailView.as_view(), name='user-detail'),

    path('schema/', schema_view, name='schema'),
    path('docs/', swagger_ui, name='swagger-ui'),
    path('redoc/', redoc_ui, name='redoc'),
]

print("✅ URLs configured with docs, redoc, and authentication endpoints")



