# =====================================================
# ENTERPRISE LOGGING (Inventory Module)
# =====================================================

LOG_DIR = os.path.join(BASE_DIR, "logs")
os.makedirs(LOG_DIR, exist_ok=True)

LOGGING = {
    "version": 1,
    "disable_existing_loggers": False,
    "formatters": {
        "verbose": {
            "format": "[{asctime}] [{levelname}] {name} | {message}",
            "style": "{",
        },
    },
    "handlers": {
        "inventory_info": {
            "level": "INFO",
            "class": "logging.FileHandler",
            "filename": os.path.join(LOG_DIR, "inventory.log"),
            "formatter": "verbose",
        },
        "inventory_error": {
            "level": "ERROR",
            "class": "logging.FileHandler",
            "filename": os.path.join(LOG_DIR, "inventory_errors.log"),
            "formatter": "verbose",
        },
    },
    "loggers": {
        "inventory": {
            "handlers": ["inventory_info", "inventory_error"],
            "level": "INFO",
            "propagate": False,
        },
    },
}


