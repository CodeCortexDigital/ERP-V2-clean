import os
import logging
from celery import Celery
from celery.schedules import crontab


# =====================================================
# DJANGO SETTINGS
# =====================================================

os.environ.setdefault("DJANGO_SETTINGS_MODULE", "erp_core.settings")


# =====================================================
# CELERY APP INITIALIZATION
# =====================================================

app = Celery("erp_core")

# Load configuration from Django settings (CELERY_ prefix)
app.config_from_object("django.conf:settings", namespace="CELERY")

# Auto-discover tasks
app.autodiscover_tasks()


# =====================================================
# LOGGING
# =====================================================

logger = logging.getLogger("inventory")


# =====================================================
# CELERY BEAT SCHEDULE
# =====================================================

app.conf.beat_schedule = {

    # -----------------------------------------------
    # Low Stock Scan (Every 15 Minutes)
    # -----------------------------------------------
    "low-stock-scan-every-15-minutes": {
        "task": "apps.business.inventory.tasks.scheduler.scheduled_low_stock_scan",
        "schedule": 900.0,  # 15 minutes
    },

    # -----------------------------------------------
    # Expiry Scan (Daily at 2:00 AM)
    # -----------------------------------------------
    "expiry-scan-daily": {
        "task": "apps.business.inventory.tasks.scheduler.scheduled_expiry_scan",
        "schedule": crontab(hour=2, minute=0),
    },

    # -----------------------------------------------
    # Escalation Engine (Every 1 Hour)
    # -----------------------------------------------
    "escalate-unresolved-low-stock-hourly": {
        "task": "apps.business.inventory.tasks.scheduler.escalate_unresolved_low_stock",
        "schedule": 3600.0,  # every 1 hour
    },
}


# =====================================================
# STARTUP LOG
# =====================================================

logger.info("Celery Enterprise Scheduler Initialized")