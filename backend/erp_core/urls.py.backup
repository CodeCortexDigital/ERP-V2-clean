def schema_view(request):
    return JsonResponse({'openapi': '3.0.0', 'info': {'title': 'ERP System API', 'description': 'Enterprise ERP with 104 service apps', 'version': '2.0.0'}, 'paths': {}})


def swagger_ui(request):
    return render(request, 'swagger.html', {'schema_url': '/schema/'})


def redoc_ui(request):
    return render(request, 'redoc.html', {'schema_url': '/schema/'})


@api_view(['POST'])
@permission_classes([AllowAny])
def firebase_login_view(request):
    from services.core.accounts.firebase_auth import verify_firebase_token
    from rest_framework_simplejwt.tokens import RefreshToken
    
    id_token = request.data.get('id_token')
    if not id_token:
        return Response({'error': 'id_token is required'}, status=400)
    
    try:
        user, token = verify_firebase_token(id_token)
        refresh = RefreshToken.for_user(user)
        return Response({'access': str(refresh.access_token), 'refresh': str(refresh), 'user': {'id': str(user.id), 'email': user.email, 'full_name': getattr(user, 'full_name', ''), 'is_active': user.is_active}})
    except Exception as e:
        return Response({'error': str(e)}, status=401)


