@api_view(['GET'])
@permission_classes([AllowAny])
def cross_service_info(request):
    return JsonResponse({
        'cross_service_integrations': {
            'hr_finance': {'description': 'HR payroll connects to Finance accounts payable', 'endpoints': ['/api/hr/payroll/run/', '/api/finance/payable/process/']},
            'education_finance': {'description': 'Education billing connects to Finance receivable', 'endpoints': ['/api/education/billing/invoice/', '/api/finance/receivable/student/']},
            'crm_commerce': {'description': 'CRM leads to Commerce orders', 'endpoints': ['/api/crm/leads/convert/', '/api/commerce/orders/create/']},
            'scm_finance': {'description': 'SCM procurement to Finance payable', 'endpoints': ['/api/scm/procurement/purchase/', '/api/finance/payable/vendor/']},
            'core_notifications': {'description': 'Core notifications across all services', 'endpoints': ['/api/notifications/send/', '/api/core/notifications/']},
            'analytics_dashboard': {'description': 'Analytics aggregates data from all services', 'endpoints': ['/api/analytics/reports/', '/api/analytics/visualization/']},
        },
        'workflow_automations': [
            {'name': 'Employee Onboarding', 'steps': ['HR recruitment -> HR employee -> Finance payroll']},
            {'name': 'Student Admission', 'steps': ['Education admission -> Education billing -> Finance receivable']},
            {'name': 'Purchase Order', 'steps': ['SCM procurement -> SCM warehouse -> Finance payable']},
            {'name': 'Lead to Sale', 'steps': ['CRM lead -> CRM opportunity -> Commerce order']},
        ]
    })


@api_view(['GET'])
@permission_classes([AllowAny])
def service_status(request):
    services = {
        'core': {'status': 'active', 'endpoints': 7},
        'hr': {'status': 'active', 'endpoints': 4},
        'education': {'status': 'active', 'endpoints': 10},
        'finance': {'status': 'active', 'endpoints': 5},
        'crm': {'status': 'active', 'endpoints': 5},
        'commerce': {'status': 'active', 'endpoints': 3},
        'scm': {'status': 'active', 'endpoints': 4},
        'analytics': {'status': 'active', 'endpoints': 2},
        'infrastructure': {'status': 'active', 'endpoints': 3},
        'shared': {'status': 'active', 'endpoints': 7},
        'ai': {'status': 'active', 'endpoints': 5},
        'business': {'status': 'active', 'endpoints': 2},
    }
    return JsonResponse({'services': services, 'timestamp': str(datetime.now())})


