# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
DEBUG=False
SECRET_KEY=your-secure-production-secret-key
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ==============================================================================
# ADMIN ACCOUNT (runtime utilities)
# ==============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-production-admin-password
ADMIN_PASSWORD_RESET_KEY=your-admin-password-reset-key

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
# USE_SQLITE=true
# USE_PGBOUNCER=true
# DB_CONN_MAX_AGE=0
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SLOW_QUERY_MS=200
# DB_QUERY_MONITORING=true
# DB_ARCHIVAL_ENABLED=true
# DB_ARCHIVE_ATTENDANCE_YEARS=2
# DB_ARCHIVE_NOTIFICATION_DAYS=90
# DB_ARCHIVE_AUDIT_DAYS=90
# DB_ARCHIVE_BATCH_SIZE=1000

# ==============================================================================
# CELERY CONFIGURATION
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CHANNEL_REDIS_URL=redis://localhost:6379/2
# Set true for WebSockets without Redis (dev only)
# USE_INMEMORY_CHANNELS=true

# Frontend WebSocket base (notifications)
VITE_WS_URL=ws://127.0.0.1:8000/ws/notifications
CACHE_KEY_PREFIX=erp
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL_STUDENT_LIST=300
CACHE_TTL_CLASS_LIST=3600
CACHE_TTL_DASHBOARD=60
CACHE_TTL_ANALYTICS=900
CACHE_TTL_DROPDOWN=86400

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ==============================================================================
# SENTRY ERROR TRACKING
# ==============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development

# ==============================================================================
# AWS S3 / Cloudflare R2 (media, backups, reports)
# ==============================================================================
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=erp-media
AWS_MEDIA_BUCKET_NAME=erp-media
AWS_BACKUP_BUCKET_NAME=erp-backups
AWS_REPORTS_BUCKET_NAME=erp-reports
AWS_PUBLIC_BUCKET_NAME=erp-public
AWS_S3_REGION_NAME=auto
# Cloudflare R2 example:
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
STORAGE_SIGNED_URL_EXPIRY=3600
STORAGE_MAX_IMAGE_BYTES=10485760
STORAGE_MAX_PDF_BYTES=5242880
STORAGE_TEMP_MAX_AGE_HOURS=24
DEFAULT_TENANT_CODE=DEF
TENANT_BASE_DOMAIN=erp.com
CLAMAV_ENABLED=false
CLAMAV_BIN=clamscan

# ==============================================================================
# WHATSAPP CONFIGURATION
# ==============================================================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ==============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
JAZZCASH_HASH_KEY=your-hash-key

JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk
JAZZCASH_REDIRECT_URL=http://localhost:5173/payment-success
JAZZCASH_WEBHOOK_SECRET=your-jazzcash-webhook-secret

EASYPAISA_MERCHANT_ID=your-merchant-id
EASYPAISA_PASSWORD=your-password

EASYPAYSA_API_URL=https://sandbox.easypaisa.com.pk
EASYPAYSA_REDIRECT_URL=http://localhost:5173/payment-success
EASYPAYSA_WEBHOOK_SECRET=your-easypaisa-webhook-secret

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ==============================================================================
# AUTOMATION & VERIFICATION CREDENTIALS
# ==============================================================================
AUDIT_EMAIL=automation@example.com
AUDIT_PASSWORD=your-audit-user-password
VERIFY_EMAIL=automation@example.com
VERIFY_PASSWORD=your-audit-user-password
VERIFY_BASE_URL=http://localhost:8000/api/v1

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/erp/django.log

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
VITE_APP_VERSION=1.0.0

# ==============================================================================
# OPENAI/GEMINI CONFIGURATION (for AI features)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_ONLINE_PAYMENTS=true
FEATURE_AI_INSIGHTS=false
FEATURE_REALTIME_NOTIFICATIONS=true
FEATURE_ADVANCED_ANALYTICS=true

# ==============================================================================
# BACKUP & DISASTER RECOVERY
# ==============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_OUTPUT_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_YEARLY=7
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=backups
BACKUP_STANDBY_REGION=us-west-2
BACKUP_RTO_HOURS=4
BACKUP_RPO_HOURS=24
WAL_ARCHIVE_DIR=/backups/wal_archive
ENABLE_BASEBACKUP=false
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# MONITORING CONFIGURATION
# ==============================================================================
PROMETHEUS_PORT=8001
GRAFANA_URL=http://localhost:3000
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
