# ==============================================================================
# DJANGO SETTINGS
# ==============================================================================
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# CELERY CONFIGURATION
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CACHE_KEY_PREFIX=erp
REDIS_POOL_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
CACHE_TTL_STUDENT_LIST=300
CACHE_TTL_CLASS_LIST=3600
CACHE_TTL_DASHBOARD=60
CACHE_TTL_ANALYTICS=900
CACHE_TTL_DROPDOWN=86400

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# ==============================================================================
# SENTRY ERROR TRACKING
# ==============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_RELEASE=1.0.0
SENTRY_ENVIRONMENT=development

# ==============================================================================
# AWS/S3 CONFIGURATION (for file storage)
# ==============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# ==============================================================================
# WHATSAPP CONFIGURATION
# ==============================================================================
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# ==============================================================================
# PAYMENT GATEWAY CONFIGURATION
# ==============================================================================
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
JAZZCASH_HASH_KEY=your-hash-key

EASYPAISA_MERCHANT_ID=your-merchant-id
EASYPAISA_PASSWORD=your-password

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# ==============================================================================
# JWT CONFIGURATION
# ==============================================================================
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/erp/django.log

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
VITE_APP_VERSION=1.0.0

# ==============================================================================
# OPENAI/GEMINI CONFIGURATION (for AI features)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_ONLINE_PAYMENTS=true
FEATURE_AI_INSIGHTS=false
FEATURE_REALTIME_NOTIFICATIONS=true
FEATURE_ADVANCED_ANALYTICS=true

# ==============================================================================
# BACKUP & DISASTER RECOVERY
# ==============================================================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_OUTPUT_DIR=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MONTHLY=12
BACKUP_RETENTION_YEARLY=7
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=backups
BACKUP_STANDBY_REGION=us-west-2
BACKUP_RTO_HOURS=4
BACKUP_RPO_HOURS=24
WAL_ARCHIVE_DIR=/backups/wal_archive
ENABLE_BASEBACKUP=false
AWS_S3_BUCKET=
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# MONITORING CONFIGURATION
# ==============================================================================
PROMETHEUS_PORT=8001
GRAFANA_URL=http://localhost:3000
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
