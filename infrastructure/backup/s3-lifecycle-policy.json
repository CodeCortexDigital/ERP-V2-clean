{
  "Rules": [
    {
      "ID": "erp-daily-to-monthly",
      "Status": "Enabled",
      "Filter": { "Prefix": "backups/" },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 90,
          "StorageClass": "GLACIER"
        },
        {
          "Days": 365,
          "StorageClass": "DEEP_ARCHIVE"
        }
      ],
      "Expiration": { "Days": 2555 }
    },
    {
      "ID": "erp-retain-30-daily",
      "Status": "Enabled",
      "Filter": { "Prefix": "backups/", "Tag": { "Key": "backup-tier", "Value": "daily" } },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 30 }
    }
  ]
}
