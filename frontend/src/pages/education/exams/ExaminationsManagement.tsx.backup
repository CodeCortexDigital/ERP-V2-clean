import { useState } from 'react'
import { Plus, Search, Calendar, Clock, FileText, Eye, Edit, Trash2, Award } from 'lucide-react'
import { Button } from '@/components/ui/Button'
import { Input } from '@/components/ui/Input'
import { Badge } from '@/components/ui/Badge'

interface Exam {
  id: number
  exam_code: string
  name: string
  course: string
  exam_date: string
  duration: string
  total_marks: number
  passing_marks: number
  venue: string
  status: 'upcoming' | 'ongoing' | 'completed'
}

const SAMPLE_EXAMS: Exam[] = [
  { id: 1, exam_code: 'MID-CS101', name: 'Mid Term Exam', course: 'Computer Science', exam_date: '2024-03-20', duration: '3 hours', total_marks: 100, passing_marks: 40, venue: 'Hall A', status: 'upcoming' },
  { id: 2, exam_code: 'FIN-MATH202', name: 'Final Exam', course: 'Mathematics', exam_date: '2024-03-25', duration: '3 hours', total_marks: 100, passing_marks: 40, venue: 'Hall B', status: 'upcoming' },
]

export default function ExaminationsManagement() {
  const [exams, setExams] = useState(SAMPLE_EXAMS)

  return (
    <div className="space-y-6">
      <div className="flex justify-between items-center"><div><h1 className="text-2xl font-bold text-gray-900">Examinations</h1><p className="text-gray-500">Manage exams, schedules, and results</p></div><Button><Plus className="h-4 w-4 mr-2" />Schedule Exam</Button></div>
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div className="bg-white rounded-lg border p-4"><p className="text-sm text-gray-500">Upcoming Exams</p><p className="text-2xl font-bold text-yellow-600">8</p></div>
        <div className="bg-white rounded-lg border p-4"><p className="text-sm text-gray-500">Ongoing</p><p className="text-2xl font-bold text-blue-600">2</p></div>
        <div className="bg-white rounded-lg border p-4"><p className="text-sm text-gray-500">Completed</p><p className="text-2xl font-bold text-green-600">24</p></div>
        <div className="bg-white rounded-lg border p-4"><p className="text-sm text-gray-500">Passing Rate</p><p className="text-2xl font-bold text-purple-600">87%</p></div>
      </div>
      <div className="border rounded-lg overflow-hidden"><table className="w-full"><thead className="bg-gray-50"><tr><th>Exam Code</th><th>Exam Name</th><th>Course</th><th>Date</th><th>Duration</th><th>Marks</th><th>Venue</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>{exams.map(e => (<tr key={e.id} className="border-t hover:bg-gray-50"><td className="px-4 py-3 font-mono">{e.exam_code}</td><td className="px-4 py-3 font-medium">{e.name}</td><td className="px-4 py-3">{e.course}</td><td className="px-4 py-3">{e.exam_date}</td><td className="px-4 py-3">{e.duration}</td><td className="px-4 py-3">{e.total_marks}</td><td className="px-4 py-3">{e.venue}</td><td className="px-4 py-3"><Badge variant={e.status === 'upcoming' ? 'warning' : e.status === 'ongoing' ? 'info' : 'success'}>{e.status}</Badge></td><td className="px-4 py-3"><div className="flex gap-2"><button className="text-blue-600"><Eye className="h-4 w-4" /></button><button className="text-green-600"><Edit className="h-4 w-4" /></button></div></td></tr>))}</tbody>
        </table>
      </div>
    </div>
  )
}
